# TELEGRAM BOT SOZLAMALARI
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
BOT_NAME=Imkon
ADMIN_IDS=123456789,987654321

# POSTGRESQL MA'LUMOTLAR BAZASI (AWS RDS yoki Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imkon_db
DB_USER=postgres
DB_PASSWORD=postgres_secret_password
# To'liq URL (ixtiyoriy, agar ko'rsatilsa alohida parametrlardan ustun turadi)
# DATABASE_URL=postgresql://postgres:postgres_secret_password@localhost:5432/imkon_db

# AWS BULUTLI XOTIRA (S3) - Ixtiyoriy
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=imkon-storage

# TIZIM SOZLAMALARI
DEFAULT_LANGUAGE=uz
TIMEZONE=Asia/Tashkent
QUIET_HOURS_START=22
QUIET_HOURS_END=8
NOTIFICATION_THRESHOLD_SCORE=75
